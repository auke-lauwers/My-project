# Pick one provider and fill in its key. Copy this file to .env.
LEADFINDER_PROVIDER=serper

# serper.dev — Google results, 2,500 free searches to start (recommended)
SERPER_API_KEY=

# serpapi.com — Google results
SERPAPI_API_KEY=

# api.search.brave.com — Brave's own index, finds people Google misses
BRAVE_API_KEY=

# Google Programmable Search — 100 free searches/day
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
